    "babel-loader": "9.2.1",
    "es6-promise": "4.2.8"
  },
  "devDependencies": {
    "autoprefixer": "10.4.27",
    "copyfiles": "2.4.1",
    "css-loader": "6.11.0",
    "css-minimizer-webpack-plugin": "5.0.1",
    "eslint": "8.57.1",
    "file-loader": "6.2.0",
